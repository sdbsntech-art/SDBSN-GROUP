# ==============================================================================
# SDBSNX OFFICIAL DIGITAL PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite - exposed to client bundle)
# ------------------------------------------------------------------------------
# Public Supabase URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon Key (Safe for public use with Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# ------------------------------------------------------------------------------
# BACKEND SERVERLESS CONFIGURATION (Vercel Functions - NEVER EXPOSED TO CLIENT)
# ------------------------------------------------------------------------------
# Supabase URL for backend API functions
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Bypasses RLS for secure server-side operations)
# CAUTION: Never commit or expose this key to client browsers
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS CLOUD API (META DEVELOPERS)
# ------------------------------------------------------------------------------
# Meta System User / Access Token with whatsapp_business_messaging permission
WHATSAPP_CLOUD_API_TOKEN=EAAG...your-meta-access-token

# WhatsApp Phone Number ID (from Meta Developer App Dashboard)
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Admin internal alert recipient phone number with country code (e.g. 221770000000)
# This number remains strictly private and is NEVER displayed on the public site
WHATSAPP_ADMIN_RECIPIENT=221770000000

